# Indodax API Credentials
# Get your TAPIv2 key at: https://indodax.com/trade_api
indodax_api_key=YOUR_API_KEY_HERE
indodax_api_secret=YOUR_API_SECRET_HERE

# LLM Configuration (LongCat-2.0 by default)
llm_base_url=https://api.longcat.ai/openai/v1
llm_api_key=YOUR_LLM_API_KEY_HERE
llm_model=LongCat-2.0
llm_ai_response_type=openai_compatible

# Telegram Notifications
# Get token from @BotFather on Telegram
# Get chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
Telegram_Bot_Token=YOUR_TELEGRAM_BOT_TOKEN_HERE
Telegram_Chat_ID=YOUR_TELEGRAM_CHAT_ID_HERE
