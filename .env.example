# ==============================================================================
# KONFIGURASI LINGKUNGAN TRADING BOT (Indodax Crypto & Saham IHSG)
# Salin file ini menjadi `.env` lalu sesuaikan isinya dengan kredensial Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Indodax API Credentials (Untuk Trading Crypto)
# ------------------------------------------------------------------------------
# Buat API key di: https://indodax.com/trade_api
# Berikan izin: View Balance, Open Orders, Trade Execution (jangan berikan izin Withdraw).
indodax_api_key=YOUR_API_KEY_HERE
indodax_api_secret=YOUR_API_SECRET_HERE

# ------------------------------------------------------------------------------
# 2. LLM Configuration (AI Market Sentiment & Reasoning)
# ------------------------------------------------------------------------------
# Digunakan untuk analisis sinyal hybrid bersama indikator teknikal.
# Default endpoint kompatibel OpenAI / LongCat AI:
llm_base_url=https://api.longcat.ai/openai/v1
llm_api_key=YOUR_LLM_API_KEY_HERE
llm_model=LongCat-2.0
llm_ai_response_type=openai_compatible

# ------------------------------------------------------------------------------
# 3. Telegram Notifications & Command Bot
# ------------------------------------------------------------------------------
# Dapatkan Token dari @BotFather di Telegram: https://t.me/BotFather
# Dapatkan Chat ID pengguna/grup dari @userinfobot atau lewat getUpdates API
Telegram_Bot_Token=YOUR_TELEGRAM_BOT_TOKEN_HERE
Telegram_Chat_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ------------------------------------------------------------------------------
# 4. 2Captcha API Key (Optional, untuk bypass CAPTCHA)
# Dapatkan API Key dari: https://2captcha.com/

2_CAPTCHA_API_KEY=YOUR_2CAPTCHA_API_KEY_HERE