[Unit]
Description=AI Trading Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cahyo
WorkingDirectory=/home/cahyo/trading-bot
ExecStart=/home/cahyo/trading-bot/venv/bin/python3 /home/cahyo/trading-bot/bot.py
Restart=always
RestartSec=30
StandardOutput=append:/home/cahyo/trading-bot/logs/bot.log
StandardError=append:/home/cahyo/trading-bot/logs/bot_error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/cahyo/trading-bot

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
