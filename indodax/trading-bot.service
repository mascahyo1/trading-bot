[Unit]
Description=AI Trading Bot - Indodax
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cahyo
WorkingDirectory=/home/cahyo/trading/indodax
ExecStart=/home/cahyo/trading-bot/venv/bin/python3 /home/cahyo/trading/indodax/bot.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
